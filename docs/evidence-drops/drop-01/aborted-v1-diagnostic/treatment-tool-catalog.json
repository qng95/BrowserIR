[
  {
    "description": "Create an isolated BrowserIR browser and return opaque browser/page handles plus the initial revision. The benchmark pins the browser profile to 1440x900 CSS pixels at 1x, locale en-US, timezone UTC, light color scheme, and reduce reduced motion; caller-supplied profile values are ignored.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "color_scheme": {
          "enum": [
            "light",
            "dark"
          ],
          "type": "string"
        },
        "locale": {
          "maxLength": 64,
          "minLength": 2,
          "type": "string"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "timezone_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "viewport": {
          "additionalProperties": false,
          "properties": {
            "device_scale_factor": {
              "maximum": 3,
              "minimum": 0.5,
              "type": "number"
            },
            "height": {
              "maximum": 2160,
              "minimum": 240,
              "type": "integer"
            },
            "width": {
              "maximum": 3840,
              "minimum": 320,
              "type": "integer"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "name": "browser_create",
    "title": "Create browser"
  },
  {
    "description": "Navigate a page at the expected BrowserIR revision and return the resulting compact observation.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "browser_id": {
          "description": "Opaque browser handle returned by browser_create.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "expected_revision": {
          "description": "BrowserIR representation revision.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "max_tokens": {
          "description": "Maximum approximate tokens for the complete returned BrowserIR model payload.",
          "maximum": 100000,
          "minimum": 256,
          "type": "integer"
        },
        "page_id": {
          "description": "Opaque page handle returned by BrowserIR.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "browser_id",
        "url",
        "expected_revision"
      ],
      "type": "object"
    },
    "name": "browser_navigate",
    "title": "Navigate browser"
  },
