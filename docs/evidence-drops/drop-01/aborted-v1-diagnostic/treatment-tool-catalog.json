  {
    "description": "Wait for a bounded semantic condition, then return the new BrowserIR revision and delta.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "browser_id": {
          "description": "Opaque browser handle returned by browser_create.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "revision_change",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "text",
                  "type": "string"
                },
                "state": {
                  "const": "visible",
                  "type": "string"
                },
                "value": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "entity_state",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "visible",
                    "hidden",
                    "enabled",
                    "disabled",
                    "expanded",
                    "collapsed"
                  ],
                  "type": "string"
                },
                "target": {
                  "additionalProperties": false,
                  "properties": {
                    "entity_id": {
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    "page_id": {
                      "description": "Opaque page handle returned by BrowserIR.",
                      "maxLength": 256,
                      "minLength": 1,
                      "type": "string"
                    },
                    "revision": {
                      "description": "BrowserIR representation revision.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "entity_id",
                    "revision"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "target",
                "state"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "settled",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        },
        "expected_revision": {
          "description": "BrowserIR representation revision.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "max_tokens": {
          "description": "Maximum approximate tokens for the complete returned BrowserIR model payload.",
          "maximum": 100000,
          "minimum": 256,
          "type": "integer"
        },
        "page_id": {
          "description": "Opaque page handle returned by BrowserIR.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "timeout_ms": {
          "maximum": 120000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "browser_id",
        "expected_revision",
        "condition"
      ],
      "type": "object"
    },
